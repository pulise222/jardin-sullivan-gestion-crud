# Variables de entorno del backend (plantilla SIN secretos).
# Django las lee con os.environ (ver sullivan_django/settings.py). Para usarlas, defínelas en tu
# terminal o en el servicio donde publiques; el archivo real ".env" está en .gitignore y NUNCA se sube.
#
# En desarrollo no necesitas definir nada: los valores por defecto funcionan en tu computador.

# --- Seguridad ---
# Clave secreta de Django. OBLIGATORIA si DJANGO_DEBUG=False (si no, Django no arranca).
# Genera una así:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# En producción debe ser False (True muestra detalles internos de los errores).
DJANGO_DEBUG=False
# Dominios desde los que se puede acceder al backend, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del front-end autorizados por CORS, separados por coma.
DJANGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos (MySQL / XAMPP) ---
# Sin USE_MYSQL el proyecto usa SQLite (db.sqlite3).
USE_MYSQL=1
DB_NAME=sullivan
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Otros ---
FRONTEND_RESET_URL=http://localhost:5173/reset-password
